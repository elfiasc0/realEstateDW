  <Source dwd:design-time-name="8cc6b67c-7484-434e-9427-b6ba5ef14486">
    <DataSourceViewID>Propertymaster DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="c5e15eba-9976-42b7-9f75-4d60f215df5c">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;        
CREATE MEMBER CURRENTCUBE.[Measures].AverageListingPrice
 AS [Measures].[Listing Price] / [Measures].[Apartment Sale Count], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Apartment Sale'  ;        
CREATE MEMBER CURRENTCUBE.[Measures].AverageFinalPrice
 AS [Measures].[Final Price] / [Measures].[Apartment Sale Count], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Apartment Sale';        
CREATE MEMBER CURRENTCUBE.[Measures].AverageCommissionRate
 AS [Measures].[Commission Rate] / [Measures].[Apartment Sale Count], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Apartment Sale';        
CREATE MEMBER CURRENTCUBE.[Measures].PriceFlutuation
 AS IIF(
    [Measures].[AverageListingPrice] = 0 OR IsEmpty([Measures].[AverageListingPrice]),
    NULL,
    [Measures].[AverageFinalPrice] / [Measures].[AverageListingPrice]
), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Apartment Sale'  ;        
CREATE MEMBER CURRENTCUBE.[Measures].AverageSaleSpeed
 AS [Measures].[Days on Market] / [Measures].[Number of Apartments], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Apartment Sale';        
CREATE MEMBER CURRENTCUBE.[Measures].AveragePotentialBuyersPerApt
 AS [Measures].[Number of Potential Buyer] /[Measures].[Number of Apartments], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Interest'; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="941520e7-778e-4025-87c8-0ec194d58dcf">
      <ID>KPI</ID>
      <Name>Average Sale Speed</Name>
      <AssociatedMeasureGroupID>Apartment Sale</AssociatedMeasureGroupID>
      <Value>[Measures].[AverageSaleSpeed]</Value>
      <Goal>( KPIValue( "Average Sale Speed" ), ParallelPeriod ( [ID End Date].[EndDateHierarchy].[Year], 1, [ID End Date].[EndDateHierarchy].CurrentMember ) ) * 0.85</Goal>
      <Status>IIf (KPIValue( "Average Sale Speed" ) &lt; KPIGoal("Average Sale Speed"), 1, -1)</Status>
      <Trend>IIf (KPIValue( "Average Sale Speed" ) &lt; (KPIValue( "Average Sale Speed" ), ParallelPeriod([ID End Date].[EndDateHierarchy].[Year], 1, [ID End Date].[EndDateHierarchy].CurrentMember)), 1, -1)</Trend>
      <TrendGraphic>Status Arrow - Ascending</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="c7fd1894-f18a-430a-bd30-1436cc54351b">
      <ID>KPI 1</ID>
      <Name>Number of Potential Buyers</Name>
      <AssociatedMeasureGroupID>Interest</AssociatedMeasureGroupID>
      <Value>[Measures].[Number of Potential Buyer]</Value>
      <Goal>( KPIValue( "Number of Potential Buyers" ), ParallelPeriod ( [ID For Sale Start Date].[SaleStartDateHierarchy].[Month No], 1,  [ID For Sale Start Date].[SaleStartDateHierarchy].CurrentMember)) * 1.05
</Goal>
      <Status>IIf (KPIValue( "Number of Potential Buyers" ) &gt; KPIGoal("Number of Potential Buyers"), 1, -1)
</Status>
      <Trend>IIf ( KPIValue( "Number of Potential Buyers") &gt; ( KPIValue( "Number of Potential Buyers" ), ParallelPeriod ( [ID For Sale Start Date].[SaleStartDateHierarchy].[Month No], 1,  [ID For Sale Start Date].[SaleStartDateHierarchy].CurrentMember)), 1, -1)
</Trend>
      <TrendGraphic>Status Arrow - Ascending</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>